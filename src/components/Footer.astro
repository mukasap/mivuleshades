---
// Footer.astro component for Mivule Shades
// Updated with contact info, social icons, and brand styling
---

<footer class="bg-brand text-white pt-12 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-10 border-b border-border-strong">
      
      <!-- Quick Links -->
      <div class="space-y-6">
        <h3 class="text-xl font-semibold mb-4 border-b border-text-inverse/20 pb-2">
          Quick Links
        </h3>
        <ul class="space-y-3">
          <li>
            <a href="/" class="text-text-inverse/80 hover:text-accent transition-colors duration-300 flex items-center gap-2">
            
              Home
            </a>
          </li>
          <li>
            <a href="/about" class="text-text-inverse/80 hover:text-accent transition-colors duration-300 flex items-center gap-2">
                         About Us
            </a>
          </li>
          <li>
            <a href="/services" class="text-text-inverse/80 hover:text-accent transition-colors duration-300 flex items-center gap-2">
              
              Services
            </a>
          </li>
          <li>
            <a href="/gallery" class="text-text-inverse/80 hover:text-accent transition-colors duration-300 flex items-center gap-2">
             
              Gallery
            </a>
          </li>
          <li>
            <a href="/contact" class="text-text-inverse/80 hover:text-accent transition-colors duration-300 flex items-center gap-2">
            
              Contact
            </a>
          </li>
        </ul>
      </div>
      
      <!-- Contact Info -->
      <div class="space-y-6">
        <h3 class="text-xl font-semibold mb-4 border-b border-text-inverse/20 pb-2">
          Contact Info
        </h3>
        <div class="space-y-4">
          <!-- Phone -->
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
            <div>
              <a href="tel:+25678460792" class="text-text-inverse/80 hover:text-accent transition-colors duration-300 block">
                +256 784 607 92
              </a>
              <a href="tel:+25675221450" class="text-text-inverse/60 hover:text-accent transition-colors duration-300 text-sm block">
                +256 752 214 50 (WhatsApp)
              </a>
            </div>
          </div>
          
          <!-- Email -->
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <a href="mailto:info.mivuleshades@gmail.com" class="text-text-inverse/80 hover:text-accent transition-colors duration-300">
              info.mivuleshades@gmail.com
            </a>
          </div>
          
          <!-- Location -->
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <div>
              <p class="text-text-inverse/80">Kitgobwa Kasangati</p>
              <p class="text-text-inverse/60 text-sm">Uganda</p>
            </div>
          </div>
          
          <!-- Website -->
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/>
            </svg>
            <a href="https://mivuleshades.com" target="_blank" rel="noopener noreferrer" class="text-text-inverse/80 hover:text-accent transition-colors duration-300">
              mivuleshades.com
            </a>
          </div>
        </div>
      </div>
      
      <!-- Social Media & Newsletter -->
      <div class="space-y-6">
        <h3 class="text-xl font-semibold mb-4 border-b border-text-inverse/20 pb-2">
          Follow Us
        </h3>
        
        <!-- Social Icons -->
        <div class="flex gap-4 mb-6">
          <!-- Facebook -->
          <a 
            href="https://facebook.com/mivule.shades" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-text-inverse/10 hover:bg-accent hover:text-dark transition-colors duration-300 text-text-inverse"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          
          <!-- Instagram -->
          <a 
            href="https://instagram.com/mivule.shades" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-text-inverse/10 hover:bg-accent hover:text-dark transition-colors duration-300 text-text-inverse"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          
          <!-- TikTok -->
          <a 
            href="https://tiktok.com/@mivule.shades" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-text-inverse/10 hover:bg-accent hover:text-dark transition-colors duration-300 text-text-inverse"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
          </a>
        </div>
        
        <p class="text-text-inverse/80 text-sm">
          Stay updated with our latest offers, events, and venue updates.
        </p>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="pt-8 text-center">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-text-inverse/60 text-sm">
          &copy; {new Date().getFullYear()} Mivule Shades. All rights reserved.
        </p>
        <p class="text-text-inverse/60 text-sm">
          Event Grounds • Corporate Space • Family Venue
        </p>
      </div>
    </div>
    
  </div>
</footer>