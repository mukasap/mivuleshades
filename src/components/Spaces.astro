---
// SpacesSection.astro component for Mivule Shades
// The "Our Spaces: Designed for Flexibility. Reserved for You." section
import WeddingImage from '../assets/wedding.jpg'
import Corperate from '../assets/corprate.jpg'
import Family from '../assets/family.jpg'
---

<section id="spaces" class="py-16 md:py-24 bg-bg-muted">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">
        Our Spaces: Designed for Flexibility. Reserved for You.
      </h2>
      <p class="text-lg text-muted max-w-3xl mx-auto">
        Choose from our versatile venues, each tailored to different needs but united by natural beauty and modern amenities.
      </p>
    </div>
    
    <!-- Spaces Grid -->
    <div class="grid md:grid-cols-3 gap-8 md:gap-10">
      
      <!-- Space 1: Event Grounds -->
      <div class="bg-surface rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:translate-y-[-4px]">
        <!-- Image with Overlay -->
        <div class="relative h-48 md:h-56 overflow-hidden">
          <img 
            src={WeddingImage.src}
            alt="Event Grounds for Weddings and Parties" 
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
          <!-- Category Badge -->
          <div class="absolute top-4 right-4">
            <span class="inline-block px-3 py-1 rounded-full bg-accent text-dark text-sm font-semibold">
              Most Popular
            </span>
          </div>
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent"></div>
        </div>
        
        <!-- Content -->
        <div class="p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-brand/10">
              <svg class="w-6 h-6 text-brand" fill="currentColor" viewBox="0 0 24 24">
                <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-dark">Event Grounds Rental</h3>
              <p class="text-sm text-muted">Perfect for large celebrations</p>
            </div>
          </div>
          
          <p class="text mb-5">
            Weddings, Large Parties, Traditional Ceremonies, Festivals, and Cultural Events
          </p>
          
          <div class="space-y-3 mb-6">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Exclusive use of main gardens and covered areas</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Secure, ample parking for all guests</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">24/7 on-site security personnel</span>
            </div>
          </div>
          
          <!-- CTA -->
          <div class="pt-5 border-t border-border">
            <div class="flex items-center justify-between mb-4">
              <div class="text-dark">
                <div class="font-bold">Large Capacity</div>
                <div class="text-sm text-muted">Ideal for 200+ guests</div>
              </div>
              <div class="text-right">
                <div class="text-sm text-muted">Booking</div>
                <div class="font-bold text-dark">Full Day Rental</div>
              </div>
            </div>
            <a 
              href="/contact?space=event-grounds" 
              class="inline-flex items-center justify-center w-full py-3 px-4 bg-brand text-white font-semibold rounded-lg hover:bg-brand-hover transition-colors duration-300 group"
            >
              Book Event Grounds
              <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      
      <!-- Space 2: Corporate & Team -->
      <div class="bg-surface rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:translate-y-[-4px]">
        <!-- Image with Overlay -->
        <div class="relative h-48 md:h-56 overflow-hidden">
          <img 
            src={Corperate.src}
            alt="Corporate Meeting and Team Space" 
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
          <!-- Category Badge -->
          <div class="absolute top-4 right-4">
            <span class="inline-block px-3 py-1 rounded-full bg-secondary text-white text-sm font-semibold">
              Professional
            </span>
          </div>
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent"></div>
        </div>
        
        <!-- Content -->
        <div class="p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-brand/10">
              <svg class="w-6 h-6 text-brand" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13 0h-6"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-dark">Corporate & Team Space</h3>
              <p class="text-sm text-muted">Ideal for business events</p>
            </div>
          </div>
          
          <p class="text mb-5">
            Team Building Activities, Corporate Events, Workshops, Seminars, and Strategy Retreats
          </p>
          
          <div class="space-y-3 mb-6">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Designated quieter zones for focused work</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Clean, well-maintained restroom facilities</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Essential utilities (power, water, Wi-Fi) guaranteed</span>
            </div>
          </div>
          
          <!-- CTA -->
          <div class="pt-5 border-t border-border">
            <div class="flex items-center justify-between mb-4">
              <div class="text-dark">
                <div class="font-bold">Medium Capacity</div>
                <div class="text-sm text-muted">Perfect for 50-100 people</div>
              </div>
              <div class="text-right">
                <div class="text-sm text-muted">Booking</div>
                <div class="font-bold text-dark">Half Day Packages</div>
              </div>
            </div>
            <a 
              href="/contact?space=corporate" 
              class="inline-flex items-center justify-center w-full py-3 px-4 bg-brand text-white font-semibold rounded-lg hover:bg-brand-hover transition-colors duration-300 group"
            >
              Book Corporate Space
              <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      
      <!-- Space 3: Family & Leisure -->
      <div class="bg-surface rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:translate-y-[-4px]">
        <!-- Image with Overlay -->
        <div class="relative h-48 md:h-56 overflow-hidden">
          <img 
            src={Family.src} 
            alt="Family and Kids Play Areas" 
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
          <!-- Category Badge -->
          <div class="absolute top-4 right-4">
            <span class="inline-block px-3 py-1 rounded-full bg-accent text-dark text-sm font-semibold">
              Family Friendly
            </span>
          </div>
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent"></div>
        </div>
        
        <!-- Content -->
        <div class="p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-brand/10">
              <svg class="w-6 h-6 text-brand" fill="currentColor" viewBox="0 0 24 24">
                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-dark">Daily Leisure & Family</h3>
              <p class="text-sm text-muted">Perfect for casual gatherings</p>
            </div>
          </div>
          
          <p class="text mb-5">
            Birthday Parties, Family Events, Outdoor Activities, Play Dates, and Weekend Relaxation
          </p>
          
          <div class="space-y-3 mb-6">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Access to Kids Play area & picnic spots</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Hourly or half-day flexible bookings</span>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Safe, monitored environment for children</span>
            </div>
          </div>
          
          <!-- CTA -->
          <div class="pt-5 border-t border-border">
            <div class="flex items-center justify-between mb-4">
              <div class="text-dark">
                <div class="font-bold">Small to Medium</div>
                <div class="text-sm text-muted">Comfortable for up to 50 people</div>
              </div>
              <div class="text-right">
                <div class="text-sm text-muted">Booking</div>
                <div class="font-bold text-dark">Flexible Hourly Rates</div>
              </div>
            </div>
            <a 
              href="/contact?space=family" 
              class="inline-flex items-center justify-center w-full py-3 px-4 bg-brand text-white font-semibold rounded-lg hover:bg-brand-hover transition-colors duration-300 group"
            >
              Book Family Space
              <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      
    </div>
    
    <!-- Bottom CTA -->
    <div class="mt-12 md:mt-16 text-center">
      <div class="bg-surface rounded-2xl p-8 border border-border">
        <h3 class="text-xl font-bold text-dark mb-4">Need a Custom Solution?</h3>
        <p class="text-muted mb-6 max-w-2xl mx-auto">
          We can tailor our spaces to meet your specific requirements. Whether you need combined areas, extended hours, or special arrangements, we're here to help.
        </p>
        <a 
          href="/contact" 
          class="inline-flex items-center gap-2 bg-accent text-dark font-bold py-3 px-8 rounded-full hover:bg-secondary hover:text-inverse transition-colors duration-300 shadow-md hover:shadow-lg"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          Discuss Your Custom Needs
        </a>
      </div>
    </div>
    
  </div>
</section>