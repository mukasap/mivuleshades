---
// src/components/ContactForm.astro
---
<div id="contact-form-container" class="bg-surface rounded-2xl p-6 md:p-8 border border-border shadow-lg mb-12">
    <h3 class="text-2xl font-bold text-dark mb-6 text-center">Send us a Message</h3>
    <form id="contact-form" action="/api/contact" method="POST" class="max-w-xl mx-auto bg-white rounded-xl p-6">
        <div id="form-result" class="hidden mb-4 text-center"></div>
        <div class="mb-4">
            <label for="name" class="block text-dark font-semibold mb-2">Name</label>
            <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                class="w-full px-4 py-2 border border-border rounded-lg focus:ring-brand focus:border-brand"
            />
        </div>
        <div class="mb-4">
            <label for="email" class="block text-dark font-semibold mb-2">Email</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                class="w-full px-4 py-2 border border-border rounded-lg focus:ring-brand focus:border-brand"
            />
        </div>
        <div class="mb-6">
            <label for="message" class="block text-dark font-semibold mb-2">Message</label>
            <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required 
                class="w-full px-4 py-2 border border-border rounded-lg focus:ring-brand focus:border-brand"
            ></textarea>
        </div>
        <div class="text-center">
            <button 
                type="submit"
                id="submit-button"
                class="bg-brand text-text-inverse font-bold py-3 px-8 rounded-full hover:bg-brand-hover transition-colors duration-300 shadow-md hover:shadow-lg"
            >
                Send Message
            </button>
        </div>
    </form>
</div>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const formResult = document.getElementById('form-result') as HTMLDivElement;
    const submitButton = document.getElementById('submit-button') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const name = formData.get('name');
        const email = formData.get('email');
        const message = formData.get('message');

        // Basic validation
        if (!name || !email || !message) {
            showResult('Please fill out all fields.', 'error');
            return;
        }

        submitButton.disabled = true;
        submitButton.textContent = 'Sending...';

        try {
            const response = await fetch('/api/contact', {
                method: 'POST',
                body: formData,
            });

            if (response.ok) {
                showResult('Thank you for your message! We will get back to you soon.', 'success');
                form.reset();
            } else {
                const errorText = await response.text();
                showResult(`An error occurred: ${errorText}`, 'error');
            }
        } catch (error) {
            showResult('A network error occurred. Please try again later.', 'error');
        } finally {
            submitButton.disabled = false;
            submitButton.textContent = 'Send Message';
        }
    });

    function showResult(message: string, type: 'success' | 'error') {
        formResult.textContent = message;
        formResult.className = `mb-4 text-center p-4 rounded-lg ${type === 'success' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}`;
        formResult.classList.remove('hidden');

        setTimeout(() => {
            formResult.classList.add('hidden');
        }, 5000); // Hide after 5 seconds
    }
</script>
