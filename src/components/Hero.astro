---
/* Hero.astro — Improved Forest Venue Hero */
---

<section
  class="relative bg-cover bg-center min-h-[65vh] md:min-h-[70vh]"
  style="background-image: url('/images/hero.jpg');"
>
  <!-- Gradient overlay -->
   <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/40 to-black/60 flex items-center justify-center">
    <div class="relative text-center px-4 max-w-4xl mx-auto text-inverse">

     <!-- Title with enhanced shadow -->
      <h1 class="hero-title text-4xl sm:text-5xl md:text-6xl font-bold mb-5 tracking-tight 
                 text-white drop-shadow-2xl">
        Mivule Shades
      </h1>


       <!-- Subtitle with better contrast -->
      <p class="hero-subtitle max-w-2xl mx-auto text-lg sm:text-xl md:text-2xl 
                 leading-relaxed mb-10 text-white/95 drop-shadow-lg">
        A serene forest-inspired venue for weddings, corporate events,
        and intimate family gatherings.
      </p>

      <!-- Location Badge with enhanced visibility -->
      <div class="hero-badge inline-flex items-center gap-2 px-5 py-2 mb-10
                  rounded-full border border-white/40
                  bg-white/20 backdrop-blur-md shadow-lg">
        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span class="text-sm font-semibold text-white">
          Kitagobwa, Kansangati
        </span>
      </div>

      <!-- CTAs -->
      <div class="hero-cta flex flex-col sm:flex-row gap-5 justify-center items-center">

        <!-- Primary CTA -->
        <a
          href="/contact"
          class="group relative overflow-hidden bg-brand hover:bg-brand-hover 
                 text-white font-semibold py-4 px-10 text-lg min-w-[220px]
                 rounded-full transition-all duration-300 transform hover:scale-105
                 shadow-xl hover:shadow-2xl border-2 border-brand/20
                 flex items-center justify-center gap-2"
        >
          <span class="relative z-10">Book Your Space</span>
          <svg class="w-5 h-5 relative z-10 transition-transform duration-300 group-hover:translate-x-1" 
               fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                  d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
          <div class="absolute inset-0 bg-white/10 transform translate-y-full 
                      group-hover:translate-y-0 transition-transform duration-300"></div>
        </a>

       <!-- Secondary CTA -->
        <a
          href="/gallery"
          class="group relative overflow-hidden bg-white/90 hover:bg-white 
                 text-brand font-semibold py-4 px-10 text-lg min-w-[220px]
                 rounded-full transition-all duration-300 transform hover:scale-105
                 shadow-xl hover:shadow-2xl border-2 border-white/50
                 flex items-center justify-center gap-2"
        >
          <span class="relative z-10">View Gallery</span>
          <svg class="w-5 h-5 relative z-10 transition-transform duration-300 group-hover:scale-110" 
               fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <div class="absolute inset-0 bg-brand/10 transform -translate-y-full 
                      group-hover:translate-y-0 transition-transform duration-300"></div>
        </a>
      </div>

    </div>
  </div>
</section>

<style is:global>
@keyframes fadeInSoft {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero-title {
  animation: fadeInSoft 0.9s ease-out 0.15s both;
}

.hero-subtitle {
  animation: fadeInSoft 0.9s ease-out 0.35s both;
}

.hero-badge {
  animation: fadeInSoft 0.9s ease-out 0.55s both;
}

.hero-cta {
  animation: fadeInSoft 0.9s ease-out 0.75s both;
}
</style>
