---
// Hero.astro component for Mivule Shades
// Uses your brand theme colors and components
---

<section class="relative bg-cover bg-center min-h-[65vh] md:min-h-[70vh]" style="background-image: url('/images/hero.jpg');">
  <!-- Gradient overlay with brand colors -->
  <div class="absolute inset-0 bg-gradient-to-b from-brand/50 via-brand/30 to-dark/40 flex items-center justify-center">
    <div class="text-center px-4 max-w-4xl mx-auto">
      
      <!-- Main Title -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-text-inverse mb-4 drop-shadow-lg tracking-tight">
        Mivule Shades
      </h1>
      
      <!-- Subtitle -->
      <p class="text-lg sm:text-xl md:text-2xl text-text-inverse mb-8 drop-shadow-md leading-relaxed">
        Versatile Space Rental for Events, Corporate Functions, and Family Gatherings
      </p>
      
      <!-- Location Badge -->
      <div class="inline-flex items-center bg-bg/80 backdrop-blur-sm rounded-full px-4 py-2 mb-8 border border-border/50">
        <svg class="w-5 h-5 mr-2 text-accent" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span class="text-sm font-semibold text-dark">
          Kitagobwa, Kansangati
        </span>
      </div>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        
        <!-- Primary CTA -->
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 bg-accent text-dark font-bold py-4 px-8 rounded-full text-lg hover:bg-secondary hover:text-text-inverse transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1 min-w-[200px]"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Book Your Space
        </a>
        
        <!-- Secondary CTA -->
        <a
          href="/gallery"
          class="inline-flex items-center justify-center gap-2 bg-bg text-dark font-semibold py-3 px-6 rounded-full border-2 border-accent hover:bg-accent hover:border-accent hover:text-dark transition-all duration-300 min-w-[180px]"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          View Gallery
        </a>
        
      </div>
      
      <!-- Scroll Indicator -->
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-text-inverse/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
      
    </div>
  </div>
</section>

<style>
  /* Custom animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Apply animations to hero elements */
  h1 {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }
  
  p {
    animation: fadeInUp 0.8s ease-out 0.4s both;
  }
  
  .inline-flex:first-of-type { /* Location badge */
    animation: fadeInUp 0.8s ease-out 0.6s both;
  }
  
  .flex { /* CTA buttons container */
    animation: fadeInUp 0.8s ease-out 0.8s both;
  }
</style>