---
// FeaturesSection.astro — CORRECT VERSION
import WeddingImage from '../assets/wedding.jpg'
import ConnectImage from '../assets/connect.jpg'
import CherishImage from '../assets/party.jpg'
---

<section class="py-16 md:py-24 bg-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-brand mb-4">
        Discover Mivule Shades
      </h2>
      <p class="text-lg text-muted max-w-3xl mx-auto">
        A versatile natural venue designed for every occasion—from grand celebrations to intimate gatherings
      </p>
    </div>

    <!-- Features Grid (FIXED) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">

      <!-- Feature: Celebrate -->
      <div class="bg-surface rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
        <div class="relative h-48 md:h-56 overflow-hidden">
          <img
            src={WeddingImage.src}
            alt="Celebrate Weddings and Traditional Ceremonies"
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </div>

        <div class="p-6 md:p-8">
          <h3 class="text-2xl font-bold text-brand mb-3">
            Celebrate
          </h3>
          <p class="text-muted mb-6 leading-relaxed">
            From intimate weddings and vibrant birthdays to culturally rich traditional ceremonies, our gardens provide a stunning backdrop for life's milestones.
          </p>

          <ul class="space-y-2 mb-6 text-text">
            <li>✔ Weddings & Kwanjula</li>
            <li>✔ Birthdays & Anniversaries</li>
            <li>✔ Festivals & Cultural Events</li>
          </ul>

          <a
            href="/services#celebrate"
            class="inline-flex items-center justify-center w-full py-3 rounded-lg bg-brand text-inverse font-semibold hover:bg-brand-hover transition"
          >
            Explore Event Spaces
          </a>
        </div>
      </div>

      <!-- Feature: Connect -->
      <div class="bg-surface rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
        <div class="relative h-48 md:h-56 overflow-hidden">
          <img
            src={ConnectImage.src}
            alt="Corporate Events and Team Building"
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </div>

        <div class="p-6 md:p-8">
          <h3 class="text-2xl font-bold text-brand mb-3">
            Connect
          </h3>
          <p class="text-muted mb-6 leading-relaxed">
            Elevate your corporate events, team-building activities, or workshops in our inspiring environment.
          </p>

          <ul class="space-y-2 mb-6 text-text">
            <li>✔ Team Building Retreats</li>
            <li>✔ Corporate Meetings</li>
            <li>✔ Workshops & Seminars</li>
          </ul>

          <a
            href="/services#corporate"
            class="inline-flex items-center justify-center w-full py-3 rounded-lg bg-brand text-inverse font-semibold hover:bg-brand-hover transition"
          >
            Book Corporate Space
          </a>
        </div>
      </div>

      <!-- Feature: Cherish -->
      <div class="bg-surface rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
        <div class="relative h-48 md:h-56 overflow-hidden">
          <img
            src={CherishImage.src}
            alt="Family Gatherings and Children's Play Areas"
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </div>

        <div class="p-6 md:p-8">
          <h3 class="text-2xl font-bold text-brand mb-3">
            Cherish
          </h3>
          <p class="text-muted mb-6 leading-relaxed">
            Dedicated areas for family events and children's play ensure comfort, safety, and joy.
          </p>

          <ul class="space-y-2 mb-6 text-text">
            <li>✔ Family Picnics & BBQs</li>
            <li>✔ Kids' Birthday Parties</li>
            <li>✔ Weekend Relaxation</li>
          </ul>

          <a
            href="/services#family"
            class="inline-flex items-center justify-center w-full py-3 rounded-lg bg-brand text-inverse font-semibold hover:bg-brand-hover transition"
          >
            View Amenities
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-16 pt-10 border-t border-border">
      <p class="text-muted mb-6">
        Looking for something specific? We customize spaces to match your unique needs.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-accent text-brand font-bold py-3 px-8 rounded-full hover:bg-secondary hover:text-inverse transition shadow-md"
      >
        Discuss Your Event
      </a>
    </div>

  </div>
</section>
