---
// FeaturesSection.astro component for Mivule Shades
import WeddingImage from '../assets/wedding.jpg'
import ConnectImage from '../assets/connect.jpg'
import CherishImage from '../assets/party.jpg'
---

<section class="py-16 md:py-24 bg-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-4">
        Discover Mivule Shades
      </h2>
      <p class="text-lg text-text-muted max-w-3xl mx-auto">
        A versatile natural venue designed for every occasion—from grand celebrations to intimate gatherings
      </p>
    </div>
    
    <!-- Features Grid -->
    <div class="grid md:grid-cols-3 gap-8 md:gap-10">
      
      <!-- Feature 1: Celebrate -->
      <div class="bg-surface rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:translate-y-[-8px]">
        <div class="relative h-48 md:h-56 overflow-hidden">
          <img 
            src={WeddingImage.src}
            alt="Celebrate Weddings and Traditional Ceremonies" 
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
          <div class="absolute top-4 left-4">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent/20 backdrop-blur-sm">
              <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </span>
          </div>
        </div>
        
        <div class="p-6 md:p-8">
          <h3 class="text-2xl font-bold text-dark mb-3 flex items-center gap-2">
            <span class="text-brand">Celebrate</span>
          </h3>
          <p class="text-text-muted mb-6 leading-relaxed">
            From intimate weddings and vibrant birthdays to culturally rich traditional ceremonies, our gardens provide a stunning backdrop for life's milestones.
          </p>
          
          <ul class="space-y-2 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Weddings & Kwanjula</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Birthdays & Anniversaries</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Festivals & Cultural Events</span>
            </li>
          </ul>
          
          <a 
            href="/services#celebrate" 
            class="inline-flex items-center justify-center w-full py-3 px-4 bg-brand text-text-inverse font-semibold rounded-lg hover:bg-brand-hover transition-colors duration-300 group"
          >
            Explore Event Spaces
            <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Feature 2: Connect -->
      <div class="bg-surface rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:translate-y-[-8px]">
        <div class="relative h-48 md:h-56 overflow-hidden">
          <img 
            src={ConnectImage.src}
            alt="Corporate Events and Team Building" 
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
          <div class="absolute top-4 left-4">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent/20 backdrop-blur-sm">
              <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13 0h-6"/>
              </svg>
            </span>
          </div>
        </div>
        
        <div class="p-6 md:p-8">
          <h3 class="text-2xl font-bold text-dark mb-3 flex items-center gap-2">
            <span class="text-brand">Connect</span>
          </h3>
          <p class="text-text-muted mb-6 leading-relaxed">
            Elevate your corporate events, team-building activities, or workshops in our inspiring environment that fosters collaboration and fresh thinking.
          </p>
          
          <ul class="space-y-2 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Team Building Retreats</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Corporate Meetings</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Workshops & Seminars</span>
            </li>
          </ul>
          
          <a 
            href="/services#corporate" 
            class="inline-flex items-center justify-center w-full py-3 px-4 bg-brand text-text-inverse font-semibold rounded-lg hover:bg-brand-hover transition-colors duration-300 group"
          >
            Book Corporate Space
            <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Feature 3: Cherish -->
      <div class="bg-surface rounded-2xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl hover:translate-y-[-8px]">
        <div class="relative h-48 md:h-56 overflow-hidden">
          <img 
            src={CherishImage.src} 
            alt="Family Gatherings and Children's Play Areas" 
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
          <div class="absolute top-4 left-4">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent/20 backdrop-blur-sm">
              <svg class="w-6 h-6 text-accent" fill="currentColor" viewBox="0 0 24 24">
                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </span>
          </div>
        </div>
        
        <div class="p-6 md:p-8">
          <h3 class="text-2xl font-bold text-dark mb-3 flex items-center gap-2">
            <span class="text-brand">Cherish</span>
          </h3>
          <p class="text-text-muted mb-6 leading-relaxed">
            Dedicated areas for family events and children's play ensure a perfect balance of fun, safety, and tranquility for the moments that matter most.
          </p>
          
          <ul class="space-y-2 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Family Picnics & BBQs</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Kids' Birthday Parties</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-dark">Weekend Relaxation</span>
            </li>
          </ul>
          
          <a 
            href="/services#family" 
            class="inline-flex items-center justify-center w-full py-3 px-4 bg-brand text-text-inverse font-semibold rounded-lg hover:bg-brand-hover transition-colors duration-300 group"
          >
            View Amenities
            <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>
      
    </div>
    
    <!-- Bottom CTA -->
    <div class="text-center mt-12 md:mt-16 pt-8 border-t border-border">
      <p class="text-text-muted mb-6">
        Looking for something specific? We customize spaces to match your unique needs.
      </p>
      <a 
        href="/contact" 
        class="inline-flex items-center gap-2 bg-accent text-dark font-bold py-3 px-8 rounded-full hover:bg-secondary hover:text-text-inverse transition-colors duration-300 shadow-md hover:shadow-lg"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        Discuss Your Event
      </a>
    </div>
    
  </div>
</section>