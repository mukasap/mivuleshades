---
// services.astro - Services page for Mivule Shades
import Layout from '../layouts/Layout.astro';
import Wedding from '../assets/wedding.jpg';
import Connect from '../assets/connect.jpg';
import Party from '../assets/party.jpg';
import WeddingShoot from '../assets/wedding-shoot.png';
import Corporate from '../assets/corprate.jpg';
import Family from '../assets/family.jpg';

const title = "Mivule Shades – Our Services for Celebrations & Events";
const description = "Explore the services at Mivule Shades: event spaces, family areas, team-building, photoshoots, and more in Kitagobwa, Kansangati.";
const image = "/images/hero.jpg";
---

<Layout {title} {description} {image}>
  <!-- Main Content -->
  <section class="py-8 md:py-12 lg:py-16 bg-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-8 md:mb-12">
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-dark mb-3 md:mb-4">
          Our Services
        </h1>
        <p class="text-lg md:text-xl text-text-muted">
          Versatile spaces designed for every occasion. From celebrations to corporate events.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        
        <!-- Service 1: Outdoor Event Space -->
        <div class="bg-surface rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden border border-border/50">
          <div class="relative h-48 md:h-56 overflow-hidden">
            <img 
              src={Wedding.src} 
              alt="Outdoor Event Space for Weddings and Ceremonies" 
              class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
              width={400}
              height={300}
            />
            <div class="absolute top-3 right-3">
              <span class="inline-block px-3 py-1 rounded-full bg-accent/90 text-dark text-xs font-semibold">
                Most Popular
              </span>
            </div>
          </div>
          <div class="p-5 md:p-6">
            <div class="flex items-center gap-3 mb-3">
              <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-brand/10">
                <svg class="w-5 h-5 text-brand" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z"/>
                </svg>
              </div>
              <h3 class="text-lg md:text-xl font-bold text-dark">Outdoor Event Space</h3>
            </div>
            <p class="text-text text-sm md:text-base mb-4">
              Beautiful grounds ideal for weddings, kwanjula, festivals, and large celebrations.
            </p>
            <ul class="space-y-2 mb-5">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-text text-sm">Wide open garden with covered areas</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-secondary mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-text text-sm">Ample parking + 24/7 security</span>
              </li>
